NEXT_PUBLIC_SITE_URL=
NEWSLETTER_WEBHOOK_URL=

# Admin panel (/keystatic). Set to "github" to save articles as commits to the
# GitHub repo; leave unset to edit local files under `pnpm dev`.
NEXT_PUBLIC_KEYSTATIC_STORAGE=

# Created by Keystatic's "Create GitHub App" step.
KEYSTATIC_GITHUB_CLIENT_ID=
KEYSTATIC_GITHUB_CLIENT_SECRET=
KEYSTATIC_SECRET=
NEXT_PUBLIC_KEYSTATIC_GITHUB_APP_SLUG=
